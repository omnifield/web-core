{
  "type": "grid",
  "children": [
    {
      "type": "grid.cell",
      "children": [
        {
          "type": "surface",
          "props": { "data-variant": "filled" },
          "children": [
            {
              "type": "flow",
              "props": { "data-variant": "column" },
              "children": [
                {
                  "type": "typography",
                  "id": "title",
                  "label": "Заголовок",
                  "props": { "data-variant": "heading" },
                  "children": [{ "genus": "text", "value": "Остатки на складе" }]
                },
                {
                  "type": "table",
                  "id": "main-table",
                  "label": "Таблица остатков",
                  "bind": {
                    "data": "/main-table/data",
                    "columns": "/main-table/columns",
                    "defaultSorting": "/main-table/defaultSorting"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
