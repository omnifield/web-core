                  "children": [{ "genus": "text", "value": "Ошибки по службам" }]
                },
                {
                  "type": "diagram",
                  "props": { "shape": "bar-horizontal", "height": 260 },
                  "bind": {
                    "data": "/diagram-errors-by-service/data",
                    "series": "/diagram-errors-by-service/series",
                    "insets": "/diagram-errors-by-service/insets"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
