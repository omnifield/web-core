{
  "name": "@web-core/chat",
  "version": "0.3.0",
  "description": "Второй кейс слоя interfaces/ (после @web-core/feeder) — нейтральное ядро чата (юзер↔агент и юзер↔юзер одним ядром), агентность и другие возможности — опциональные фичи поверх. Ядро готово, первая фича — агентский адаптер @web-core/neurobox (подпуть ./neurobox).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "solid": "./dist/index.jsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./neurobox": {
      "development": "./src/features/neurobox/index.ts",
      "solid": "./dist/neurobox.jsx",
      "types": "./dist/neurobox.d.ts",
      "default": "./dist/neurobox.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "solid": "./dist/index.jsx",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./neurobox": {
        "solid": "./dist/neurobox.jsx",
        "types": "./dist/neurobox.d.ts",
        "default": "./dist/neurobox.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck"
  },
  "dependencies": {
    "@web-core/neurobox": "^0.4.0",
    "@web-core/ui": "^0.4.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@web-core/build": "^0.4.0",
    "@web-core/lint": "^0.4.0",
    "eslint": "^10.8.1",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
