{
  // web-core-devbox — Ф2 (kb:ADR-16 volume-workspace, kb:FUND-4 containers-only).
  // ГРИНФИЛД на стандартном Dev Containers (adopt-not-invent, kb:ADR-20): upstream-образ +
  // features + native "Clone Repository in Container Volume". БЕЗ skeleton-скриптов
  // (devbox.sh/-manifest/-session/-services) и БЕЗ biome/GH-Packages — это devopser-legacy.
  // Docker-инварианты канон-чистого девбокса сохранены (kb:DEVOPSER-3).
  "name": "web-core-devbox",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "remoteUser": "node",

  // Сеть web-core-gateway создаётся ДО контейнера и НА ХОСТЕ: войти в несуществующую сеть
  // докер не даёт, и первый девбокс на чистой машине без этой строки не встаёт. Команда
  // идемпотентна — сеть уже есть, значит не сделано ничего. Внутри контейнера здесь ещё
  // нет ничего: его самого нет.
  "initializeCommand": "docker network inspect web-core-gateway >nul 2>&1 || docker network create web-core-gateway",


  // Инварианты сети: peer-alias в общей сети web-core-gateway (соседи видят контейнер по
  // имени), host-gateway, НОЛЬ host-портов — наружу ничего не публикуем; verdaccio :4873
  // остаётся внутренним. Контейнер переживает рестарт демона.
  //
  // Служб tasker/knowledger в этой сети больше нет (сняты 2026-08-24) — сеть осталась ради
  // соседей, которые есть.
  "runArgs": [
    "--network=web-core-gateway",
    "--network-alias=web-core",
    "--add-host=host.docker.internal:host-gateway",
    "--restart=unless-stopped"
  ],

  // Переменные окружения контейнера: секрет-модель, адрес pnpm-стора.
  // Секрет-модель (kb:FUND-4): креды/кэши — в named-volume'ах, ENV указывает в /home/node/.secrets.
  // Ничего не хардкодим в образ/репо; тома переживают recreate.
  // Стор pnpm назван ДВУМЯ именами, и это не дубль: до pnpm 11 он читает npm-конфиг
  // (NPM_CONFIG_*), с 11-й — свой (PNPM_CONFIG_*). Без них при воркспейсе-томе pnpm
  // кладёт стор рядом с воркспейсом, а смонтированный том стоит нетронутым.
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.secrets/claude",
    "GIT_CONFIG_GLOBAL": "/home/node/.secrets/gitconfig",
    "GH_CONFIG_DIR": "/home/node/.secrets/gh",
    "NPM_CONFIG_USERCONFIG": "/home/node/.secrets/npmrc",
    "NPM_CONFIG_STORE_DIR": "/home/node/.pnpm-store",
    "PNPM_CONFIG_STORE_DIR": "/home/node/.pnpm-store",
    // Корень воркспейса назван ЯВНО, и это обязательное условие работы этого дерева.
    // Каждая группа здесь — самостоятельный репозиторий со своим корнем, и структура у неё
    // одна и та же, где бы она ни лежала. Значит внутри дерева корней несколько, а менеджер
    // пакетов по умолчанию берёт БЛИЖАЙШИЙ вверх от текущей папки — и команда, запущенная
    // внутри группы (граф задач запускает задачи именно так), начинает ставить ей отдельное
    // дерево зависимостей. Ловилось живьём: 641 МБ и вторая копия реактивного движка, от
    // которой рушится всё на машинах состояний.
    "NPM_CONFIG_WORKSPACE_DIR": "/workspaces/web-core"
  },

  // Тот же корень воркспейса — ВТОРОЙ раз, и это не дубль по недосмотру. `containerEnv`
  // применяется один раз, при СОЗДАНИИ контейнера: строку, добавленную позже, уже поднятый
  // контейнер не получает никогда, и сессии внутри него живут без неё — ловилось живьём,
  // пакеты базы приезжали из реестра вместо соседних папок. `remoteEnv` применяется при каждом
  // подключении, поэтому переменная встаёт и без пересоздания контейнера.
  "remoteEnv": {
    "NPM_CONFIG_WORKSPACE_DIR": "/workspaces/web-core"
  },

  // Фичи Dev Containers — настройка devcontainerFeatures. Базовый образ несёт node/pnpm/git
  // (версия pnpm — из пина самого репозитория через corepack; образ = тонкая оболочка),
  // остальные тулчейны приезжают сюда: чего тут нет, того в девбоксе нет, и постсоздание
  // говорит об этом вслух, если репозиторий тулчейн объявил.
  // Go объявлен репозиторием (`backend/presets/go.mod` — go 1.27.0, `products/windshift/go.mod`),
  // и без него красным падает не только сборка бэка: тест `apps/studio/.mcp` поднимает настоящий
  // `backend/presets` через `go run`, так что прогон зоны студии уходит в красное целиком. Пин
  // минорной ветки, не «latest»: версия тулчейна — решение репозитория, а не того, когда собрали
  // контейнер. Инструменты Go (golangci-lint и прочие) не ставим — их репозиторий не просит.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27",
      "installGoTools": false
    }
  },

  // Общие на машине named-volume'ы (одни креды/стор на все web-core-девбоксы), переживают recreate.
  // Workspace-ТОМ здесь НЕ объявляем: им управляет "Clone Repository in Container Volume"
  // (kb:ADR-16) — VS Code сам создаёт том, клонирует репо, монтирует как workspace. См. runbook.
  "mounts": [
    "source=web-core-secrets,target=/home/node/.secrets,type=volume",
    "source=web-core-pnpm-store,target=/home/node/.pnpm-store,type=volume"
  ],

  "customizations": {
    "vscode": {
      // Расширения и форматтер — настройки обвеса. Дополняют .vscode/extensions.json репо.
      "extensions": ["esbenp.prettier-vscode", "nrwl.angular-console"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },

  // Одноразовая (per-volume) цепочка: corepack→pnpm-пин + инструменты локации
  // (настройка globalTools; kb:FUND-4 — исполнение и ассистент живут В контейнере,
  // не на хосте). Версия каждого названа значением, а не подразумевается.
  // ШАГИ НАЗВАНЫ (kb:WORLD-50): каждый объявляет себя строкой «[devbox] шаг N/M …»,
  // а отказ называет шаг, на котором встали, и отдаёт его код. Шаги: фиксация редакции участка, пин пакетного менеджера, инструменты локации, браузер для живых проверок UI, фиксация редакций инструментов.
  //
  // Браузер (шаг 4/5) стоит здесь по той же причине, что и claude-code: это инструмент локации, а
  // не зависимость репозитория. Берётся Google Chrome stable из репозитория Google — apt тянет его
  // системные библиотеки сам; chrome-devtools-mcp и браузерные ручки apps/studio/.mcp поддерживают
  // именно Chrome, Chromium у них — «может работать, не гарантируем». Без этого шага сервер MCP
  // поднимается, а каждый вызов браузера падает: ровно так девбокс и простоял до 2026-09-22.
  "onCreateCommand": "bash .devcontainer/on-create.sh",

  // Репо-зависимая цепочка, шаги названы так же: названные потери тулчейна, права на общие тома, seed claude-онбординга, проверка доступа к реестру, установка зависимостей.
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
