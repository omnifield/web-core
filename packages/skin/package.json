    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^5.0.2",
    "@kobalte/core": "^0.13.12",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@web-core/build": "workspace:*",
    "@web-core/lint": "workspace:*",
    "@web-core/style": "workspace:*",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.14",
    "postcss-nested": "^7.0.2",
    "solid-js": "^1.9.14",
