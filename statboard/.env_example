# Пример локальных переменных. Скопировать в `.env` и поправить под себя.
#
# Адрес реестра, откуда ставятся пакеты `@web-core/*`. В самом репозитории уже стоит рабочий
# адрес — переменная нужна только тем, у кого реестр свой:
#
#   pnpm --@web-core:registry="$WEBCORE_REGISTRY" install
#
WEBCORE_REGISTRY=https://150.251.145.87:9873/
