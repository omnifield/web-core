            }
          },
          "open": {
            "props": {
              "@media (prefers-reduced-motion: reduce)": {
                "animation": "none"
              },
              "animation": "grow-block-size var(--motion-normal) var(--ease-out)"
            }
          }
        }
      },
      "control": {
        "ancestors": [
          {
            "component": "tree-view",
            "part": "item",
            "style": {
              "props": {
                "color": "var(--active-color, var(--neutral-12))",
                "fontWeight": "var(--active-weight, var(--weight-medium))",
