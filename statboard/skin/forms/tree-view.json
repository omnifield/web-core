{
  "name": "omnifield-tree-view",
  "component": "tree-view",
  "recipe": {
    "base": {
      "content": {
        "props": {
          "boxSizing": "border-box",
          "display": "block",
          "overflow": "hidden",
          "position": "relative"
        },
        "states": {
          "closed": {
            "props": {
              "@media (prefers-reduced-motion: reduce)": {
                "animation": "none",
                "blockSize": "0"
              },
              "animation": "shrink-block-size var(--motion-normal) var(--ease-out) forwards",
