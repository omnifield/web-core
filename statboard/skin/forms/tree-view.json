          "renaming": {
            "props": {
              "cursor": "text"
            }
          },
          "selected": {
            "props": {
              "--active-color": "var(--accent-11)",
              "--active-weight": "var(--weight-semibold)"
            }
          }
        }
      },
      "root": {
        "props": {
          "display": "flex",
          "flexDirection": "column"
        }
      }
    },
    "defaultVariant": "plain",
