{
  "name": "omnifield-accordion",
  "component": "accordion",
  "recipe": {
    "base": {
      "content": {
        "props": {
          "boxSizing": "border-box",
          "color": "var(--neutral-11)",
          "fontSize": "var(--font-size-md)",
          "lineHeight": "var(--leading-relaxed)",
          "overflow": "hidden"
        },
        "states": {
          "closed": {
            "props": {
              "@media (prefers-reduced-motion: reduce)": {
                "animation": "none"
              },
              "animation": "shrink-block-size var(--motion-normal) var(--ease-out)"
            }
          },
          "disabled": {
            "props": {
              "color": "var(--neutral-11)"
            }
          },
          "open": {
            "props": {
              "@media (prefers-reduced-motion: reduce)": {
                "animation": "none"
              },
              "animation": "grow-block-size var(--motion-normal) var(--ease-out)"
            }
          }
        }
      },
      "control": {
        "props": {
          "@media (prefers-reduced-motion: reduce)": {
            "transition": "none"
          },
          "alignItems": "center",
          "background": "transparent",
          "borderWidth": "0",
          "color": "var(--neutral-12)",
          "cursor": "pointer",
          "display": "flex",
          "fontSize": "var(--font-size-md)",
          "fontWeight": "var(--weight-medium)",
          "gap": "var(--space-2)",
          "justifyContent": "space-between",
          "lineHeight": "var(--leading-none)",
          "minBlockSize": "var(--control-height-sm)",
          "paddingBlock": "var(--space-1)",
          "paddingInline": "var(--space-2)",
          "textAlign": "start",
          "transition": "background-color var(--motion-fast) var(--ease-out), color var(--motion-fast) var(--ease-out), border-color var(--motion-fast) var(--ease-out)"
        },
        "states": {
          "disabled": {
            "props": {
              "cursor": "not-allowed",
              "opacity": "0.6"
            }
          },
          "focus-visible": {
            "props": {
              "outline": "var(--border-width-2) solid var(--accent-8)",
              "outlineOffset": "calc(var(--border-width-2) * -1)"
            }
          }
        }
      },
      "controlIndicator": {
        "props": {
          "@media (prefers-reduced-motion: reduce)": {
            "transition": "none"
          },
          "alignItems": "center",
          "color": "var(--neutral-11)",
          "display": "inline-flex",
          "justifyContent": "center",
          "transition": "transform var(--motion-fast) var(--ease-out)"
        },
        "states": {
          "disabled": {
            "props": {
              "opacity": "0.6"
            }
          },
          "open": {
            "props": {
              "transform": "rotate(180deg)"
            }
          }
        }
      },
      "item": {
        "props": {
          "display": "flex",
          "flexDirection": "column"
        }
      },
      "root": {
        "props": {
          "color": "var(--neutral-12)",
          "display": "flex",
          "flexDirection": "column",
          "gap": "var(--space-1)"
        }
      }
    },
    "defaultVariant": "cards",
    "keyframes": {
