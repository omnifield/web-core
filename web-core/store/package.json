{
  "name": "@web-core/store",
  "version": "0.4.0",
  "description": "Стейт web-core поверх семьи XState: @xstate/store как zustand-подобное глобальное хранилище, xstate как опциональный слой полноценных стейт-машин (PROBEWEB-4).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./machine": {
      "development": "./src/machine/index.ts",
      "types": "./dist/machine/index.d.ts",
      "default": "./dist/machine/index.js"
    },
    "./persist": {
      "development": "./src/addons/persist.ts",
      "types": "./dist/addons/persist.d.ts",
      "default": "./dist/addons/persist.js"
    },
    "./undo": {
      "development": "./src/addons/undo.ts",
      "types": "./dist/addons/undo.d.ts",
      "default": "./dist/addons/undo.js"
    },
    "./reset": {
      "development": "./src/addons/reset.ts",
      "types": "./dist/addons/reset.d.ts",
      "default": "./dist/addons/reset.js"
    },
    "./validate": {
      "development": "./src/addons/validate.ts",
      "types": "./dist/addons/validate.d.ts",
      "default": "./dist/addons/validate.js"
    },
    "./mutate": {
      "development": "./src/addons/mutate.ts",
      "types": "./dist/addons/mutate.d.ts",
      "default": "./dist/addons/mutate.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./machine": {
        "types": "./dist/machine/index.d.ts",
        "default": "./dist/machine/index.js"
      },
      "./persist": {
        "types": "./dist/addons/persist.d.ts",
        "default": "./dist/addons/persist.js"
      },
      "./undo": {
        "types": "./dist/addons/undo.d.ts",
        "default": "./dist/addons/undo.js"
      },
      "./reset": {
        "types": "./dist/addons/reset.d.ts",
        "default": "./dist/addons/reset.js"
      },
      "./validate": {
        "types": "./dist/addons/validate.d.ts",
        "default": "./dist/addons/validate.js"
      },
      "./mutate": {
        "types": "./dist/addons/mutate.d.ts",
        "default": "./dist/addons/mutate.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@web-core/solid": "workspace:*",
    "@xstate/store": "4.2.3",
    "@xstate/store-solid": "2.0.0",
    "immer": "11.1.18"
  },
  "peerDependencies": {
    "@xstate/solid": "^2.0.0",
    "solid-js": "^1.9.14",
    "xstate": "^5.32.6"
  },
  "peerDependenciesMeta": {
    "@xstate/solid": {
      "optional": true
    },
    "xstate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@web-core/build": "workspace:*",
    "@web-core/lint": "workspace:*",
    "@xstate/solid": "2.0.0",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "solid-js": "1.9.14",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10",
    "xstate": "5.32.6"
  }
}
