{
  "name": "@web-core/trace",
  "version": "0.4.0",
  "description": "Perf-трейсер web-core: ядро без фреймворка + необязательный Solid-плагин (createLifeTracer, TraceProvider).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./solid": {
      "development": "./src/solid.ts",
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./solid": {
        "types": "./dist/solid.d.ts",
        "default": "./dist/solid.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "^1.9.14"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
