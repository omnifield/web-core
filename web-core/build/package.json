{
  "name": "@web-core/build",
  "version": "0.5.0",
  "description": "Оснастка сборки web-core: фабрика конфига Vite, базовый tsconfig, пресет vitest, TS-раннер для серверов и рантайм-ридер env для приложений (`/env`).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "web-core-node": "./dist/bin.mjs",
    "web-core-vite": "./dist/bin-vite.mjs",
    "web-core-vitest": "./dist/bin-vitest.mjs"
  },
  "exports": {
    "./vite": {
      "development": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./vitest": {
      "development": "./src/vitest/index.ts",
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    },
    "./env": {
      "development": "./src/env.ts",
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./test": {
      "development": "./src/test.ts",
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    },
    "./tsconfig": "./dist/tsconfig/frontend.json",
    "./tsconfig-node": "./dist/tsconfig/node.json",
    "./client": "./dist/client.d.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./vite": {
        "types": "./dist/vite/index.d.ts",
        "default": "./dist/vite/index.js"
      },
      "./vitest": {
        "types": "./dist/vitest/index.d.ts",
        "default": "./dist/vitest/index.js"
      },
      "./env": {
        "types": "./dist/env.d.ts",
        "default": "./dist/env.js"
      },
      "./test": {
        "types": "./dist/test.d.ts",
        "default": "./dist/test.js"
      },
      "./tsconfig": "./dist/tsconfig/frontend.json",
      "./tsconfig-node": "./dist/tsconfig/node.json",
      "./client": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/tsconfig && cp src/tsconfig/frontend.json dist/tsconfig/frontend.json && cp src/tsconfig/node.json dist/tsconfig/node.json && cp src/tsconfig/shared.json dist/tsconfig/shared.json && cp src/client.d.ts dist/client.d.ts && cp src/vendor-bin.mjs dist/vendor-bin.mjs && cp src/bin.mjs dist/bin.mjs && cp src/bin-vite.mjs dist/bin-vite.mjs && cp src/bin-vitest.mjs dist/bin-vitest.mjs && chmod +x dist/bin.mjs dist/bin-vite.mjs dist/bin-vitest.mjs",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@typescript/typescript6": "6.0.2",
    "@web-core/trace": "workspace:*",
    "esbuild": "0.27.7",
    "rollup": "4.63.1",
    "rollup-plugin-dts": "6.5.1",
    "jsdom": "30.0.1",
    "solid-js": "1.9.14",
    "tsx": "4.23.13",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
