{
  "//": [
    "Конфиг САМОГО пакета. Своего `tsconfig` наружу `ui` не отдаёт — базу приложениям задаёт",
    "зона `build` подпутём `/tsconfig` (PROBEWEB-4).",
    "",
    "`jsx: preserve` здесь не стилистика, а поставка: ветка `solid` в `exports` обязана",
    "отдать НЕПРЕОБРАЗОВАННЫЙ JSX, и типы должны проверяться ровно в той же форме, в",
    "которой он уезжает. `jsxImportSource` — `solid-js`; Solid 2.0 унесёт JSX-типы в",
    "`@solidjs/web`, и переезд поедет отсюда (фонд `solid-2.0-migration.md`)."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    // Исходники в тарбол не едут (`files` манифеста), поэтому карта обязана нести их в
    // себе — иначе у потребителя она указывает в пустоту.
    "inlineSources": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts", "generators"],
  "exclude": ["dist", "node_modules"]
}
