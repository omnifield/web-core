    "@zag-js/toast": "1.43.1",
    "@zag-js/toc": "1.43.1",
    "@zag-js/toggle": "1.43.1",
    "@zag-js/toggle-group": "1.43.1",
    "@zag-js/tree-view": "1.43.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "lucide-solid": "1.41.0"
  },
  "peerDependencies": {
    "@ark-ui/solid": "^5.39.1",
