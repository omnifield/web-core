{
  "//": [
    "Конфиг САМОГО пакета: собирает исходники пресета и его тесты. Базы наружу зона `lint`",
    "не отдаёт — это дело зоны `build` (`@web-core/build/tsconfig`).",
    "",
    "Из проверки исключены `test/fixtures` и `test/consumer`: первые НАРОЧНО написаны",
    "неверно (на них ловится линтер), второй — отдельный проект со своей базой типов."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    // Исходники в тарбол не едут (`files` манифеста), поэтому карта обязана нести их в
    // себе — иначе у потребителя она указывает в пустоту.
    "inlineSources": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test/*.ts", "vitest.config.ts"],
  "exclude": ["test/fixtures", "test/consumer", "dist", "node_modules"]
}
