{
  "//": [
    "Конфиг САМОГО пакета: собирает исходники движка и типизирует его тесты.",
    "Базы для потребителя здесь нет и не будет — её отдаёт зона `build` подпутём",
    "`@web-core/build/tsconfig`."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    // JSX нужен ТЕСТАМ: проба подпути `./keyed` рендерит настоящий <Key>, а он пишется на JSX.
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    // Исходники в тарбол не едут (`files` манифеста), поэтому карта обязана нести их в
    // себе — иначе у потребителя она указывает в пустоту. По той же причине нет
    // `declarationMap`: карте деклараций подкладывать в себя нечего.
    "inlineSources": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
