# Зависимости и результаты сборки — порождаются на месте, в репозитории им не место.
node_modules/
dist/
*.tgz
*.tsbuildinfo

# Граф задач: кэш и служебные данные — машинное, своё на каждой машине.
.nx/cache/
.nx/workspace-data/

# А вот планы версий (`.nx/version-plans/`) НЕ игнорируются намеренно: изменение объявляется
# файлом в ветке рядом с кодом, и именно из этих файлов собирается CHANGELOG при выпуске.

# Локальные настройки окружения.
.env
.env.*
!.env.example
